# ============================================================
# Unity .gitattributes
# - Routes binary assets through Git LFS
# - Uses Unity's SmartMerge (UnityYAMLMerge) for scenes/prefabs/etc.
# Teammates: run `git lfs install` once, and configure the
# unityyamlmerge driver (see README "First-time setup").

* text=auto
# ----- Unity YAML text assets: merge with UnityYAMLMerge -----
*.unity                  merge=unityyamlmerge
*.prefab                 merge=unityyamlmerge
*.asset                  merge=unityyamlmerge
*.mat                    merge=unityyamlmerge
*.anim                   merge=unityyamlmerge
*.controller             merge=unityyamlmerge
*.overrideController     merge=unityyamlmerge
*.physicMaterial         merge=unityyamlmerge
*.physicsMaterial2D      merge=unityyamlmerge
*.playable               merge=unityyamlmerge
*.mask                   merge=unityyamlmerge
*.brush                  merge=unityyamlmerge
*.flare                  merge=unityyamlmerge
*.fontsettings           merge=unityyamlmerge
*.guiskin                merge=unityyamlmerge
*.giparams               merge=unityyamlmerge
*.renderTexture          merge=unityyamlmerge
*.spriteatlas            merge=unityyamlmerge
*.terrainlayer           merge=unityyamlmerge
*.mixer                  merge=unityyamlmerge
*.shadervariants         merge=unityyamlmerge
*.preset                 merge=unityyamlmerge
# =============================================================
# Git LFS — binary assets
# 3D models
*.fbx        filter=lfs diff=lfs merge=lfs -text
*.FBX        filter=lfs diff=lfs merge=lfs -text
*.obj        filter=lfs diff=lfs merge=lfs -text
*.blend      filter=lfs diff=lfs merge=lfs -text
*.blend1     filter=lfs diff=lfs merge=lfs -text
*.dae        filter=lfs diff=lfs merge=lfs -text
*.3ds        filter=lfs diff=lfs merge=lfs -text
*.glb        filter=lfs diff=lfs merge=lfs -text
*.gltf       filter=lfs diff=lfs merge=lfs -text
